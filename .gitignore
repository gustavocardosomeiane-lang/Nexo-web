# Dependências (o site não usa nenhuma em runtime)
node_modules/

# Segredos — nunca versionar
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Build e cache de hospedagem
.vercel/
.netlify/
dist/
build/
.cache/

# Sistema operacional
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Editores
.vscode/
.idea/
*.swp
*~

# Logs
*.log
npm-debug.log*

# Vinculo local com a Vercel: contem VERCEL_OIDC_TOKEN.
.vercel

# Nenhum arquivo de ambiente real entra no Git. O `.env.example` e a excecao:
# ele so tem placeholders vazios e serve de documentacao das variaveis.
.env*
!.env.example
