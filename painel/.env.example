# =============================================================================
# NEXO WEB — Painel administrativo
# Copie para `.env.local` (nunca vai pro Git). Na Vercel, cadastre em
# Settings → Environment Variables.
# =============================================================================
#
# A REGRA QUE NÃO PODE SER ESQUECIDA
# Tudo com prefixo VITE_ é compilado dentro do JavaScript e fica VISÍVEL para
# qualquer visitante. Variável SEM o prefixo só existe no servidor (funções
# em /api) e nunca chega ao navegador.
#
#   Chave pública / anon key ......... pode levar VITE_
#   Secret key / service_role / token  NUNCA leva VITE_


# -----------------------------------------------------------------------------
# MODO DE OPERAÇÃO
# -----------------------------------------------------------------------------
# mock       -> dados de demonstração no navegador, nenhuma rede. Padrão.
# production -> exige Supabase configurado abaixo. Nenhum dado fictício.
VITE_DATA_MODE=mock


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# Frontend (Project Settings → API). A anon key é pública por natureza;
# quem protege os dados são as policies de RLS em supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVIDOR — usadas pelo webhook, que é chamado pelo Asaas e não tem sessão
# de usuário para o RLS avaliar. A service_role IGNORA RLS: jamais com VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# ASAAS
# -----------------------------------------------------------------------------
# Liga o adaptador do Asaas. Com `none`, o painel recusa qualquer cobrança
# explicando o motivo, em vez de simular sucesso.
VITE_PAYMENT_PROVIDER=asaas

# SERVIDOR — a chave da API. Nunca com VITE_.
# Asaas → Integrações → Chave de API.
ASAAS_API_KEY=

# Ambiente. Vazio ou qualquer coisa != sandbox => PRODUÇÃO (api.asaas.com).
# Use `sandbox` para testar sem depender da aprovação da conta.
ASAAS_ENV=

# SERVIDOR — token do webhook. Invente uma string longa e aleatória e
# cadastre a MESMA no painel do Asaas ao criar o webhook.
# Sem ela, /api/webhooks/asaas recusa tudo (falha fechado, de propósito).
ASAAS_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# NINJABOT — modo assistido
# -----------------------------------------------------------------------------
# O NinjaBot em uso não expõe API pública. Em `assistido`, o painel monta as
# campanhas, os lotes de 10 e o controle de quem já foi contatado; o envio
# acontece no WhatsApp/painel do NinjaBot e você confirma no sistema.
#
# `api` fica reservado para quando existir uma API de verdade. Não há endpoint
# inventado no código.
VITE_NINJABOT_MODO=assistido
VITE_NINJABOT_PROVIDER=none
VITE_NINJABOT_API_URL=
# Se um dia houver token, ele é de SERVIDOR:
# NINJABOT_API_KEY=
