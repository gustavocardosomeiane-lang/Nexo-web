# =============================================================================
# NEXO WEB — Painel administrativo
# Copie para `.env.local` (nunca vai pro Git). Na Vercel, cadastre em
# Settings → Environment Variables.
# =============================================================================
#
# A REGRA QUE NÃO PODE SER ESQUECIDA
# Tudo com prefixo VITE_ é compilado dentro do JavaScript e fica VISÍVEL para
# qualquer visitante. Variável SEM o prefixo só existe no servidor (funções
# em /api) e nunca chega ao navegador.
#
#   Chave pública / anon key ......... pode levar VITE_
#   Secret key / service_role / token  NUNCA leva VITE_


# -----------------------------------------------------------------------------
# MODO DE OPERAÇÃO
# -----------------------------------------------------------------------------
# mock       -> dados de demonstração no navegador, nenhuma rede. Padrão.
# production -> exige Supabase configurado abaixo. Nenhum dado fictício.
VITE_DATA_MODE=mock

# URL canônica do painel. Usada para montar o link do e-mail de recuperação
# de senha.
#
# POR QUE NÃO DEIXAR EM BRANCO: sem ela, o link usa a origem de onde a
# recuperação foi pedida. Num preview da Vercel isso vira
# `nexo-painel-git-abc.vercel.app`, que não está na lista de Redirect URLs do
# Supabase — e o clique no e-mail devolve
# {"error":"requested path is invalid"}.
VITE_APP_URL=https://nexo-painel-bay.vercel.app


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# Frontend (Project Settings → API). A anon key é pública por natureza;
# quem protege os dados são as policies de RLS em supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVIDOR — usadas pelo webhook, que é chamado pelo Asaas e não tem sessão
# de usuário para o RLS avaliar. A service_role IGNORA RLS: jamais com VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SERVIDOR — a MESMA anon key pública de cima, disponível para as funções.
# A NEXO AI a usa para validar a sessão do usuário e consultar o banco COM A
# RLS dele (nunca com service_role). É pública por natureza; sem prefixo VITE_
# só porque quem a lê é o servidor.
SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# ASAAS
# -----------------------------------------------------------------------------
# Liga o adaptador do Asaas. Com `none`, o painel recusa qualquer cobrança
# explicando o motivo, em vez de simular sucesso.
VITE_PAYMENT_PROVIDER=asaas

# SERVIDOR — a chave da API. Nunca com VITE_.
# Asaas → Integrações → Chave de API.
ASAAS_API_KEY=

# Ambiente. Vazio ou qualquer coisa != sandbox => PRODUÇÃO (api.asaas.com).
# Use `sandbox` para testar sem depender da aprovação da conta.
ASAAS_ENV=

# SERVIDOR — token do webhook. Invente uma string longa e aleatória e
# cadastre a MESMA no painel do Asaas ao criar o webhook.
# Sem ela, /api/webhooks/asaas recusa tudo (falha fechado, de propósito).
ASAAS_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# NEXO AI (IA interna do dashboard)
# -----------------------------------------------------------------------------
# SERVIDOR — texto: Groq (openai/gpt-oss-20b), provider único. Nunca com
# VITE_: dá acesso pago à API e jamais pode chegar ao navegador. Vive só em
# api/_lib/nexo-ai/modelo.ts, lida via process.env.GROQ_API_KEY.
GROQ_API_KEY=

# SERVIDOR — voz (TTS) da NEXO AI: Google Cloud Text-to-Speech (Chirp3 HD),
# autenticado de forma KEYLESS (Vercel OIDC -> Google STS -> impersonação da
# service account nexo-tts — ver api/_lib/nexo-ai/google-tts-auth.ts). Sem
# chave JSON: a organização bloqueia iam.disableServiceAccountKeyCreation.
# Usadas só em api/nexo-ai/falar.ts — INDEPENDENTES do texto acima, não
# remover. Mesmo projeto do Google Places (nexo-ai-506000).
#
# Nenhuma delas é secreta (são identificadores, visíveis em qualquer console
# do IAM) — o segredo de verdade é o access_token, obtido só em runtime e
# nunca gravado em lugar nenhum.
# Confirmado por você.
GCP_PROJECT_NUMBER=333777789753
# ATENÇÃO: os dois abaixo são o ID (não o nome de exibição) do pool/provider
# — confirme em IAM & Admin -> Workload Identity Federation -> [seu pool] no
# Console; o valor abaixo é só o exemplo mais comum, não uma confirmação.
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
GOOGLE_TTS_SERVICE_ACCOUNT=nexo-tts@nexo-ai-506000.iam.gserviceaccount.com

# Nome exato da voz do Cloud TTS. Opcional — sem isso usa o padrão fixo no
# código (pt-BR-Chirp3-HD-Kore, voz feminina). Só preencha pra trocar de voz
# sem precisar mexer no código.
GOOGLE_TTS_VOICE=

# OBSOLETA — era o JSON da conta de serviço, usado antes da migração pra
# autenticação keyless (Vercel OIDC + Workload Identity Federation). Não é
# mais lida por nenhum código do projeto.
GOOGLE_TTS_CREDENCIAIS=

# OBSOLETAS — eram a chave/voz da ElevenLabs, usada como TTS antes da troca
# para Google Cloud Text-to-Speech (a conta ficou sem créditos). Não são mais
# lidas por nenhum código do projeto — as funções que as usavam ainda existem
# em api/nexo-ai/falar.ts, mas o handler não as chama mais. Mantidas aqui só
# até a Google TTS ser validada em produção; depois disso, podem ser
# removidas também da Vercel.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OBSOLETAS — eram a chave/modelo do Anthropic, usado como fallback de texto
# antes da troca para Groq. Não são mais lidas por nenhum código do projeto
# (ver api/_lib/nexo-ai/modelo.ts). Mantidas aqui só até a validação de Groq
# em produção; depois disso, podem ser removidas também da Vercel.
NEXO_AI_API_KEY=
NEXO_AI_MODELO=claude-sonnet-5

# OBSOLETA — era a chave do Gemini TTS ("Kore"), usado como voz da NEXO antes
# da troca para ElevenLabs. Não é mais lida por nenhum código do projeto (ver
# api/nexo-ai/falar.ts). Mantida aqui só até a validação da ElevenLabs em
# produção; depois disso, pode ser removida também da Vercel.
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# PROSPECÇÃO AUTOMÁTICA (busca de negócios locais pela NEXO AI)
# -----------------------------------------------------------------------------
# SERVIDOR — chave da Google Places API (New): Text Search + Place Details.
# Nunca com VITE_: dá acesso pago à API do Google e jamais pode chegar ao
# navegador. Fica restrita, no Google Cloud Console, às APIs "Places API
# (New)" — não conceda escopo além do necessário.
GOOGLE_PLACES_API_KEY=
