# =============================================================================
# NEXO WEB — Painel administrativo
# Copie este arquivo para `.env.local` e preencha. `.env.local` NUNCA vai pro Git.
# =============================================================================
#
# REGRA DE OURO
# Isto e uma SPA: tudo que comeca com VITE_ e compilado dentro do JavaScript e
# fica VISIVEL para qualquer visitante. Portanto:
#
#   - Chave publica / anon key  -> pode entrar aqui.
#   - Secret key / service_role -> NUNCA. Nem aqui, nem em lugar nenhum do painel.
#
# As secrets vivem apenas no servidor que receber os webhooks (Edge Function do
# Supabase ou funcao serverless). Ver painel/README.md, secao "Webhooks".


# -----------------------------------------------------------------------------
# MODO DE OPERACAO
# -----------------------------------------------------------------------------
# mock       -> dados ficticios de demonstracao, nenhuma rede. Padrao.
# production -> exige Supabase configurado abaixo. Sem dado mock em lugar nenhum.
VITE_DATA_MODE=mock


# -----------------------------------------------------------------------------
# SUPABASE  (obrigatorio quando VITE_DATA_MODE=production)
# -----------------------------------------------------------------------------
# Painel do Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NUNCA preencha service_role aqui. Ela ignora Row Level Security.


# -----------------------------------------------------------------------------
# GATEWAY DE PAGAMENTO
# -----------------------------------------------------------------------------
# Nenhum gateway foi escolhido ainda. Preencha quando contratar um que ofereca
# PIX, cartao, parcelamento, checkout, API e webhooks.
#
# Identificador do adaptador em src/integrations/payments/. "none" = desligado.
VITE_PAYMENT_PROVIDER=none
VITE_PAYMENT_API_URL=
# Chave PUBLICA (checkout/tokenizacao no navegador). Pode ficar no frontend.
VITE_PAYMENT_PUBLIC_KEY=
#
# As duas abaixo sao do SERVIDOR. Nao levam VITE_ de proposito — se levassem,
# iriam parar no bundle. Configure no ambiente da funcao que trata webhooks:
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# NINJABOT
# -----------------------------------------------------------------------------
# API ainda nao fornecida. A arquitetura esta pronta, o adaptador nao existe.
VITE_NINJABOT_PROVIDER=none
VITE_NINJABOT_API_URL=
# Token do NinjaBot e credencial de servidor. Nao colocar no frontend.
# NINJABOT_API_KEY=
